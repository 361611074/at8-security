msgstr "此下载链接已失效。"

msgid ""
"This key is already active on %1$d site(s). Release it there first, or ask "
"for the allowance to be raised."
msgstr "此密钥已绑定 %1$d 个站点。请先解绑，或申请提高站点数量上限。"

msgid "This licence key belongs to a different product."
msgstr "此授权密钥属于其他产品。"

msgid "This licence key has been disabled."
msgstr "此授权密钥已被停用。"

msgid "This licence key has been revoked."
msgstr "此授权密钥已被吊销。"

msgid "This licence key has expired."
msgstr "此授权密钥已过期。"

msgid "This licence key is not recognised."
msgstr "此授权密钥无法识别。"

msgid "This site is not activated with this key."
msgstr "此站点未使用该密钥激活。"

msgid "Too many attempts. Please try again later."
msgstr "尝试次数过多，请稍后再试。"

msgid "Unknown product"
msgstr "未知产品"

msgid "Unpublish"
msgstr "下架"

msgid ""
"Upload the add-on zip and fill in the version. Licensed sites will be "
"offered it on their Plugins screen."
msgstr "上传附加组件 zip 包并填写版本号。已授权的站点会在「插件」页面收到更新推送。"

msgid "Validity"
msgstr "有效期"

